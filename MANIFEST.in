include AGENTS.md
include CHANGELOG.md
include LICENSE
include README.md
include pyproject.toml
recursive-include .agents/skills *
recursive-include docs *.md
recursive-include examples/minimal *.md *.patch *.py
recursive-include tests *.json *.md *.py *.txt
prune .specromancy
prune build
prune dist
prune specromancy/adapters/backups
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.tmp
