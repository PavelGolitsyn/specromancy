{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Specromancy pipeline registry",
  "type": "object",
  "required": [
    "schema_version",
    "pipelines"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "pipelines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "path": {
            "type": "string",
            "pattern": "^pipelines/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.toml$"
          }
        }
      }
    }
  }
}
