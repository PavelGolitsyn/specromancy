{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specromancy.dev/schemas/event.schema.json",
  "title": "Specromancy audit event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "timestamp",
    "run_id",
    "visit_number",
    "type",
    "payload",
    "manifest_revision",
    "manifest_hash"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "timestamp": {"type": "string", "pattern": "Z$"},
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"
    },
    "visit_number": {
      "oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]
    },
    "type": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "payload": {"type": "object"},
    "manifest_revision": {"type": "integer", "minimum": 1},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
